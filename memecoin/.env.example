# Copy this file to `.env` and fill in the values. NEVER commit your real .env.

# --- Token settings (edit freely) ---
TOKEN_NAME=Awakening Coin
TOKEN_SYMBOL=AWAKE
TOKEN_SUPPLY=1000000

# --- Sepolia testnet deploy (only needed for --network sepolia) ---
# Free RPC URL from https://alchemy.com or https://infura.io
SEPOLIA_RPC_URL=

# Private key of a THROWAWAY TEST wallet only — one that has never held and will
# never hold real money. Fund it with free test ETH from a Sepolia faucet.
PRIVATE_KEY=

# Optional: for verifying source code on Etherscan (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=
